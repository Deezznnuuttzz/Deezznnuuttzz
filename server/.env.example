# Postgres connection string
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm"

# Random strings (32+ chars). Generate with: openssl rand -hex 32
JWT_SECRET=""
ENCRYPTION_KEY=""

# bcrypt hash of your login password. Generate with:
#   npm run hash-password -- "your-password-here"
APP_PASSWORD_HASH=""

PORT=4000
WEB_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# How far back to look on an email account's very first sync
EMAIL_INITIAL_SYNC_DAYS=30

# Cron expression for the background sync job (default: every 10 minutes)
SYNC_CRON_SCHEDULE="*/10 * * * *"
